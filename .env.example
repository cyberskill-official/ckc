# Code Knowledge Chain Environment Configuration

# Server settings (default loopback-only)
CKC_HOST=127.0.0.1
CKC_PORT=8000

# Shared secret for ALL /api/* routes except /api/health (static UI assets are exempt).
# Required when CKC_HOST is not loopback (127.0.0.1 / localhost / ::1) — server refuses to start otherwise.
# Prefer Authorization: Bearer <token> or X-CKC-Token headers.
# Indexing uses POST /api/index/stream with JSON body
# { "project_path", "multimodal", "force" } — never put the token in the URL.
# Legacy GET EventSource ?token= is removed (405); CKC_ALLOW_QUERY_TOKEN is ignored for index stream.
# CKC_UI_TOKEN=change-me

# Loopback may stay unauthenticated when no token is set (default). Set to 0 to require a token even on loopback.
# CKC_UI_ALLOW_UNAUTH_LOOPBACK=1

# Optional (legacy): allow ?token= on other routes if ever re-enabled — prefer headers.
# CKC_ALLOW_QUERY_TOKEN=0

# Optional: explicit CORS allow-list (comma-separated). Default is same-origin only (empty).
# Wildcard "*" is refused when CKC_HOST is not loopback; on loopback it is an explicit opt-in.
# CKC_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Trust X-Forwarded-For only from these proxy CIDRs (comma-separated). Empty = ignore XFF.
# CKC_TRUSTED_PROXIES=10.0.0.0/8,192.168.0.0/16

# Max concurrent index jobs across projects (default 2).
# CKC_MAX_CONCURRENT_INDEX=2

# Optional: LM Studio / OpenAI-compatible local synthesis (query, impact, trace)
# When set, CKC appends a short "Local model synthesis" section via urllib
# (no extra SDK). Soft-fails if the server is down. Disable per-command with --no-llm.
#
# SSRF threat model:
# - CKC will HTTP POST to CKC_LLM_BASE_URL / OPENAI_BASE_URL for chat completions.
# - Loopback hosts are allowed by default. Other private/link-local hosts (e.g.
#   169.254.169.254, 10.x, host.docker.internal) require CKC_LLM_ALLOW_PRIVATE=1.
# - Optional CKC_LLM_URL_ALLOWLIST=host1,host2 for explicit hostname allowlisting.
# - Auto-detection (probe_local_lm_studio) is intentionally loopback-only.
#
# Typical LM Studio OpenAI-compatible endpoint:
CKC_LLM_BASE_URL=http://127.0.0.1:1234/v1
CKC_LLM_MODEL=local-model
CKC_LLM_API_KEY=lm-studio
# CKC_LLM_ALLOW_PRIVATE=0
# CKC_LLM_URL_ALLOWLIST=
# Or use the Graphify-compatible aliases:
# OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# OPENAI_MODEL=local-model
# OPENAI_API_KEY=lm-studio

# Optional: disable automatic LM Studio loopback probe
# CKC_DISABLE_AUTODETECT=1

# --- ChainConfig timeouts / budgets (seconds unless noted) ---
# Index timeout model:
#   UI SSE = one shared wall-clock deadline for all engines
#   CLI/MCP IndexPipeline = full per-engine timeout each
# CKC_INDEX_TIMEOUT=300
# CKC_MULTIMODAL_INDEX_TIMEOUT=900
# Query/impact/trace wall clock (UI asyncio + CLI/MCP thread pool). Default 90
# leaves headroom for optional LLM synthesis (~45s HTTP capped inside budget).
# CKC_QUERY_TIMEOUT=90
# CKC_MAX_SEARCH_DEPTH=5
# CKC_MAX_TOKENS_BUDGET=4000
# Default Graphify mode when IndexPipeline.run(code_only=None)
# CKC_GRAPHIFY_CODE_ONLY=true
# Skip appending engine index dirs to the target repo .gitignore
# CKC_SKIP_GITIGNORE=0

# Optional: LLM Providers for Graphify Multimodal Extraction (Documentation & PDFs)
# Default indexing stays --code-only (AST). Use `code-chain init --multimodal` for
# Graphify semantic doc edges; LM Studio works if OPENAI_BASE_URL points at it.
# If left empty for Graphify multimodal, extract may fail without a cloud key.
# OPENAI_API_KEY=your_openai_key
# ANTHROPIC_API_KEY=your_anthropic_key
# GEMINI_API_KEY=your_gemini_key

# Optional: CodeGraph Telemetry (0 disables anonymous telemetry)
CODEGRAPH_TELEMETRY=0

# Structured JSON logs (fields: timestamp, level, logger, message, module, function, line)
# CKC_LOG_FORMAT=json
